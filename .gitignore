# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Otomasyonun çalışma alanı: dizin repoda sabit dursun, içeriği commit edilmesin
.temp/*
!.temp/.gitkeep


# RF-DETR model ağırlıkları (~485 MB) repoya girmez.
